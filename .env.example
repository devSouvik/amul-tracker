# ── Product to track ─────────────────────────────────────────────────────────
# Full URL of the shop.amul.com product page
PRODUCT_URL=https://shop.amul.com/en/product/amul-chocolate-whey-protein-34-g-or-pack-of-30-sachets

# 6-digit delivery pincode
PINCODE=711101

# Seconds between each stock check (default: 120 = 2 minutes)
CHECK_INTERVAL=120

# ── Email via Resend (recommended for Railway / cloud) ───────────────────────
# Resend uses HTTPS (port 443) — never blocked by cloud platforms.
# Free tier: 3,000 emails/month. Sign up at https://resend.com
#
# Setup (5 min):
#   1. Sign up at resend.com
#   2. Go to API Keys → Create API Key → copy it below
#   3. Go to Emails → Domains → Add → verify your domain
#      OR: use any Gmail you own as the sender after verifying it in Resend
#      (Resend free tier: verify a single sender email address)
#
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
# The verified sender address (must be verified in Resend dashboard)
RESEND_FROM=Amul Tracker <you@yourdomain.com>

# ── Email via Gmail SMTP (local dev only — blocked on most cloud hosts) ───────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your@gmail.com
# SMTP_PASS=xxxxxxxxxxxxxxxx

# ── Who receives alerts (used by both Resend and SMTP) ───────────────────────
NOTIFY_EMAIL=your@gmail.com
