# ── Product to track ─────────────────────────────────────────────────────────
# Full URL of the shop.amul.com product page
PRODUCT_URL=https://shop.amul.com/en/product/amul-chocolate-whey-protein-34-g-or-pack-of-30-sachets

# 6-digit delivery pincode
PINCODE=711101

# Seconds between each stock check (default: 120 = 2 minutes)
CHECK_INTERVAL=120

# ── Gmail SMTP ───────────────────────────────────────────────────────────────
# Use a Gmail App Password — NOT your real Google account password.
#
# How to create one (takes ~2 min):
#   1. Enable 2-Step Verification on your Google account:
#      https://myaccount.google.com/security
#   2. Go to: https://myaccount.google.com/apppasswords
#   3. Select app: "Mail", device: "Other (Custom name)" → type "amul-tracker"
#   4. Copy the 16-character password shown and paste it below (spaces are ok)
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx

# ── Notifications ────────────────────────────────────────────────────────────
# Who receives the alert emails (can be same as SMTP_USER)
NOTIFY_EMAIL=your@gmail.com

# Optional: custom sender address label (defaults to SMTP_USER if not set)
# SMTP_FROM=your@gmail.com
